{
  "expo": {
    "name": "字字樂園 | Mandarin Garden",
    "slug": "mandarin-garden",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mandarin-garden",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#FFF9ED"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png",
      "output": "static"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
